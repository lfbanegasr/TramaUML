digraph Clases {
graph [rankdir=LR, nodesep=0.8, ranksep=1.4, pad=0.5, splines=spline, concentrate=false, fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [arrowhead=none, arrowtail=none, fontname="Arial", fontsize=10, color="#596776", labelfontsize=10, labeldistance=2.4];
"cambio_modelo" [id="clase_cambio_modelo", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>CAMBIO_MODELO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_modelo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_sesion_edicion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_usuario_actor</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_cambio_cliente</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revision_base</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revision_aplicada</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_operacion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_entidad</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_entidad</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">parche</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">aplicado_en</TD></TR></TABLE>>];
"conflicto_edicion" [id="clase_conflicto_edicion", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>CONFLICTO_EDICION</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_modelo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_entidad</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_entidad</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revision_base</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_cambio_almacenado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_cambio_entrante</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">valor_almacenado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">valor_entrante</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_resolucion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">valor_resolucion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">detectado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">resuelto_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">resuelto_en</TD></TR></TABLE>>];
"modelo_uml" [id="clase_modelo_uml", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#eef1f4"><TR><TD HEIGHT="32"><B>MODELO_UML</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_proyecto</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">descripcion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revision_actual</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_version_actual</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">archivado_en</TD></TR></TABLE>>];
"participante_sesion_modelo" [id="clase_participante_sesion_modelo", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="229" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>PARTICIPANTE_SESION_MODELO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id_sesion_edicion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">modo_participante</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado_presencia</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_entidad_enfocada</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_entidad_enfocada</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">incorporado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ultima_presencia_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">salida_en</TD></TR></TABLE>>];
"sesion_edicion_modelo" [id="clase_sesion_edicion_modelo", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="192" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>SESION_EDICION_MODELO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_modelo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">abierto_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">modo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revision_base</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">abierto_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ultima_actividad_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">cerrado_en</TD></TR></TABLE>>];
"usuario" [id="clase_usuario", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="214" BGCOLOR="#eef1f4"><TR><TD HEIGHT="32"><B>USUARIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">correo_electronico</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_completo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">hash_contrasena</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">intentos_fallidos_acceso</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">bloqueado_hasta</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ultimo_acceso_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">desactivado_en</TD></TR></TABLE>>];
"usuario" -> "modelo_uml" [id="asociacion_1", label="crea", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO crea MODELO_UML. Lectura inversa: MODELO_UML es creado por USUARIO."];
"usuario" -> "sesion_edicion_modelo" [id="asociacion_35", label="abre", taillabel="1", headlabel="0..*", constraint=false, tooltip="USUARIO abre SESION_EDICION_MODELO. Lectura inversa: SESION_EDICION_MODELO es abierta por USUARIO."];
"sesion_edicion_modelo" -> "modelo_uml" [id="asociacion_49", label="edita", taillabel="0..*", headlabel="1", constraint=true, tooltip="SESION_EDICION_MODELO edita MODELO_UML. Lectura inversa: MODELO_UML tiene sesiones registradas en SESION_EDICION_MODELO."];
"participante_sesion_modelo" -> "sesion_edicion_modelo" [id="asociacion_50", label="pertenece a", taillabel="0..*", headlabel="1", constraint=true, tooltip="PARTICIPANTE_SESION_MODELO pertenece a SESION_EDICION_MODELO. Lectura inversa: SESION_EDICION_MODELO tiene PARTICIPANTE_SESION_MODELO."];
"usuario" -> "participante_sesion_modelo" [id="asociacion_51", label="participa mediante", taillabel="1", headlabel="0..*", constraint=true, tooltip="USUARIO participa mediante PARTICIPANTE_SESION_MODELO. Lectura inversa: PARTICIPANTE_SESION_MODELO representa a USUARIO."];
"conflicto_edicion" -> "cambio_modelo" [id="asociacion_52", label="contrasta el guardado", taillabel="0..*", headlabel="0..1", constraint=true, tooltip="CONFLICTO_EDICION contrasta el guardado CAMBIO_MODELO. Lectura inversa: CAMBIO_MODELO interviene como guardado en CONFLICTO_EDICION."];
"conflicto_edicion" -> "cambio_modelo" [id="asociacion_53", label="contrasta el entrante", taillabel="0..*", headlabel="0..1", constraint=true, tooltip="CONFLICTO_EDICION contrasta el entrante CAMBIO_MODELO. Lectura inversa: CAMBIO_MODELO interviene como entrante en CONFLICTO_EDICION."];
"cambio_modelo" -> "modelo_uml" [id="asociacion_54", label="modifica", taillabel="0..*", headlabel="1", constraint=true, tooltip="CAMBIO_MODELO modifica MODELO_UML. Lectura inversa: MODELO_UML recibe CAMBIO_MODELO."];
"cambio_modelo" -> "sesion_edicion_modelo" [id="asociacion_55", label="ocurre durante", taillabel="0..*", headlabel="0..1", constraint=true, tooltip="CAMBIO_MODELO ocurre durante SESION_EDICION_MODELO. Lectura inversa: SESION_EDICION_MODELO agrupa CAMBIO_MODELO."];
"usuario" -> "cambio_modelo" [id="asociacion_56", label="realiza", taillabel="1", headlabel="0..*", constraint=false, tooltip="USUARIO realiza CAMBIO_MODELO. Lectura inversa: CAMBIO_MODELO es realizado por USUARIO."];
"conflicto_edicion" -> "modelo_uml" [id="asociacion_57", label="afecta a", taillabel="0..*", headlabel="1", constraint=true, tooltip="CONFLICTO_EDICION afecta a MODELO_UML. Lectura inversa: MODELO_UML tiene conflictos registrados en CONFLICTO_EDICION."];
"usuario" -> "conflicto_edicion" [id="asociacion_58", label="resuelve", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO resuelve CONFLICTO_EDICION. Lectura inversa: CONFLICTO_EDICION es resuelto por USUARIO."];
}