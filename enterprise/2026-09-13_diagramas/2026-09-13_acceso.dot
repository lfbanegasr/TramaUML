digraph Clases {
graph [rankdir=LR, nodesep=0.8, ranksep=1.4, pad=0.5, splines=spline, concentrate=false, fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [arrowhead=none, arrowtail=none, fontname="Arial", fontsize=10, color="#596776", labelfontsize=10, labeldistance=2.4];
"permiso" [id="clase_permiso", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>PERMISO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">codigo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">modulo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">accion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">descripcion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ambito</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR></TABLE>>];
"rol" [id="clase_rol", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>ROL</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">codigo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">descripcion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ambito</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">es_del_sistema</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR></TABLE>>];
"rol_permiso" [id="clase_rol_permiso", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>ROL_PERMISO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id_rol</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_permiso</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">concedido_en</TD></TR></TABLE>>];
"sesion_autenticacion" [id="clase_sesion_autenticacion", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="192" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>SESION_AUTENTICACION</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">hash_token</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">hash_token_renovacion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">direccion_ip</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">agente_cliente</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">emitido_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">expira_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revocado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">motivo_revocacion</TD></TR></TABLE>>];
"usuario" [id="clase_usuario", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="214" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>USUARIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">correo_electronico</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_completo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">hash_contrasena</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">intentos_fallidos_acceso</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">bloqueado_hasta</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ultimo_acceso_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">desactivado_en</TD></TR></TABLE>>];
"usuario_rol" [id="clase_usuario_rol", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>USUARIO_ROL</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_rol</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">asignado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">asignado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">revocado_en</TD></TR></TABLE>>];
"usuario" -> "sesion_autenticacion" [id="asociacion_7", label="inicia", taillabel="1", headlabel="0..*", constraint=true, tooltip="USUARIO inicia SESION_AUTENTICACION. Lectura inversa: SESION_AUTENTICACION pertenece a USUARIO."];
"rol" -> "rol_permiso" [id="asociacion_8", label="tiene", taillabel="1", headlabel="0..*", constraint=true, tooltip="ROL tiene ROL_PERMISO. Lectura inversa: ROL_PERMISO pertenece a ROL."];
"rol_permiso" -> "permiso" [id="asociacion_9", label="asigna", taillabel="0..*", headlabel="1", constraint=true, tooltip="ROL_PERMISO asigna PERMISO. Lectura inversa: PERMISO se asigna mediante ROL_PERMISO."];
"usuario" -> "usuario_rol" [id="asociacion_10", label="tiene", taillabel="1", headlabel="0..*", constraint=true, tooltip="USUARIO tiene USUARIO_ROL. Lectura inversa: USUARIO_ROL pertenece a USUARIO."];
"usuario_rol" -> "rol" [id="asociacion_11", label="asigna", taillabel="0..*", headlabel="1", constraint=true, tooltip="USUARIO_ROL asigna ROL. Lectura inversa: ROL se asigna mediante USUARIO_ROL."];
"usuario" -> "usuario_rol" [id="asociacion_12", label="asigna", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO asigna USUARIO_ROL. Lectura inversa: USUARIO_ROL es asignada por USUARIO."];
}