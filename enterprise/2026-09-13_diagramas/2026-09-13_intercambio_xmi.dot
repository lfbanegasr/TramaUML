digraph Clases {
graph [rankdir=LR, nodesep=0.8, ranksep=1.4, pad=0.5, splines=spline, concentrate=false, fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [arrowhead=none, arrowtail=none, fontname="Arial", fontsize=10, color="#596776", labelfontsize=10, labeldistance=2.4];
"archivo_almacenado" [id="clase_archivo_almacenado", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="214" BGCOLOR="#eef1f4"><TR><TD HEIGHT="32"><B>ARCHIVO_ALMACENADO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_proyecto</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">cargado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">categoria</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">proveedor_almacenamiento</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">clave_almacenamiento</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_original</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_contenido</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tamano_bytes</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">sha256</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">eliminado_en</TD></TR></TABLE>>];
