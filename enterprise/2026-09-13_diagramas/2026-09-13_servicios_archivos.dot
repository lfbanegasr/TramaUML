digraph Clases {
graph [rankdir=LR, nodesep=0.8, ranksep=1.4, pad=0.5, splines=spline, concentrate=false, fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [arrowhead=none, arrowtail=none, fontname="Arial", fontsize=10, color="#596776", labelfontsize=10, labeldistance=2.4];
"archivo_almacenado" [id="clase_archivo_almacenado", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="214" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>ARCHIVO_ALMACENADO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_proyecto</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">cargado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">categoria</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">proveedor_almacenamiento</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">clave_almacenamiento</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_original</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_contenido</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tamano_bytes</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">sha256</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">eliminado_en</TD></TR></TABLE>>];
"comprobacion_servicio" [id="clase_comprobacion_servicio", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="192" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>COMPROBACION_SERVICIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_servicio</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">latencia_ms</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">detalle</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">comprobado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">comprobado_en</TD></TR></TABLE>>];
"proyecto" [id="clase_proyecto", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="199" BGCOLOR="#eef1f4"><TR><TD HEIGHT="32"><B>PROYECTO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">codigo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">descripcion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_usuario_propietario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">visibilidad</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">opciones</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">archivado_en</TD></TR></TABLE>>];
"secreto_servicio" [id="clase_secreto_servicio", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>SECRETO_SERVICIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">id_servicio</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">contenido_cifrado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">algoritmo_cifrado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">version_clave</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">rotado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">retirado_en</TD></TR></TABLE>>];
"servicio_plataforma" [id="clase_servicio_plataforma", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="185" BGCOLOR="#fff4e4"><TR><TD HEIGHT="32"><B>SERVICIO_PLATAFORMA</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">proveedor</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">tipo_servicio</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">url_servicio</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">configuracion</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_por</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR></TABLE>>];
"usuario" [id="clase_usuario", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="214" BGCOLOR="#eef1f4"><TR><TD HEIGHT="32"><B>USUARIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" HEIGHT="19">id</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_usuario</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">correo_electronico</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">nombre_completo</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">hash_contrasena</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">estado</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">intentos_fallidos_acceso</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">bloqueado_hasta</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">ultimo_acceso_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">creado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">actualizado_en</TD></TR><TR><TD ALIGN="LEFT" HEIGHT="19">desactivado_en</TD></TR></TABLE>>];
"usuario" -> "proyecto" [id="asociacion_13", label="posee", taillabel="1", headlabel="0..*", constraint=false, tooltip="USUARIO posee PROYECTO. Lectura inversa: PROYECTO pertenece a USUARIO."];
"archivo_almacenado" -> "proyecto" [id="asociacion_22", label="pertenece a", taillabel="0..*", headlabel="0..1", constraint=true, tooltip="ARCHIVO_ALMACENADO pertenece a PROYECTO. Lectura inversa: PROYECTO almacena ARCHIVO_ALMACENADO."];
"usuario" -> "archivo_almacenado" [id="asociacion_23", label="carga", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO carga ARCHIVO_ALMACENADO. Lectura inversa: ARCHIVO_ALMACENADO es cargado por USUARIO."];
"usuario" -> "servicio_plataforma" [id="asociacion_24", label="crea", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO crea SERVICIO_PLATAFORMA. Lectura inversa: SERVICIO_PLATAFORMA es creado por USUARIO."];
"secreto_servicio" -> "servicio_plataforma" [id="asociacion_25", label="protege", taillabel="0..*", headlabel="1", constraint=true, tooltip="SECRETO_SERVICIO protege SERVICIO_PLATAFORMA. Lectura inversa: SERVICIO_PLATAFORMA tiene secretos registrados en SECRETO_SERVICIO."];
"comprobacion_servicio" -> "servicio_plataforma" [id="asociacion_26", label="comprueba", taillabel="0..*", headlabel="1", constraint=true, tooltip="COMPROBACION_SERVICIO comprueba SERVICIO_PLATAFORMA. Lectura inversa: SERVICIO_PLATAFORMA se comprueba mediante COMPROBACION_SERVICIO."];
"usuario" -> "comprobacion_servicio" [id="asociacion_27", label="realiza", taillabel="0..1", headlabel="0..*", constraint=false, tooltip="USUARIO realiza COMPROBACION_SERVICIO. Lectura inversa: COMPROBACION_SERVICIO es realizada por USUARIO."];
}